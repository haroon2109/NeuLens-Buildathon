# Values read by docker-compose.yml. Copy to `.env` and edit; `.env` is ignored
# by git and never enters an image. Every key has a working local default except
# the optional integrations, which stay off when left empty.

# --- Database ---------------------------------------------------------------
# Change before the stack holds anything you care about.
POSTGRES_PASSWORD=neulens-local-password
# Host port for Postgres. Use 5433 if a local server already owns 5432.
POSTGRES_PORT=5432

# --- App --------------------------------------------------------------------
# At least 32 characters, or the server refuses to start in production.
# Generate one with: openssl rand -hex 32
JWT_SECRET=local-development-jwt-secret-change-before-any-real-data
# Browser origins allowed to send credentialed requests.
CLIENT_ORIGIN=http://localhost:5000,http://127.0.0.1:5000
APP_PORT=5000
# Fictional jury accounts; keep false for any instance holding real data.
DEMO_ACCESS_ENABLED=true

# --- AI service -------------------------------------------------------------
AI_SERVICE_PORT=8000
# Must be identical in the API and the Python service.
AI_SERVICE_INTERNAL_KEY=local-internal-key-change-me
# Baked into the browser bundle when the API image is built.
VITE_AI_SERVICE_URL=http://localhost:8000

# --- Optional integrations (features stay disabled when empty) --------------
# Gnani speech: STT/TTS. Without a key the portal stays silent but fully usable.
GNANI_API_KEY=
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_DAILY_BUDGET=200

# Voice copilot answers: Google Gemini (Primary for Google Startup Buildathon)
# or any OpenAI-compatible chat endpoint (hosted or Ollama).
# Leave empty and the copilot falls back to its fixed, scripted replies.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_MODEL=

# Transactional email (verification codes). Without it, codes are only logged.
RESEND_API_KEY=
EMAIL_FROM=NeuLens <no-reply@example.com>

# Only needed for browser-direct calls to the Python service.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
