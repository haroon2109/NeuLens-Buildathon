# Neulens server environment template.
# Copy to server/.env and fill in real values. Never commit the filled file.
# Generate secrets locally, e.g. `openssl rand -hex 32`.

# --- Runtime ---------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API with credentials.
CLIENT_ORIGIN=http://localhost:5173
HOST=0.0.0.0

# --- Session security ------------------------------------------------------
# Required in production; must be at least 32 characters. No fallback exists.
JWT_SECRET=

# --- Database --------------------------------------------------------------
# PostgreSQL connection string, e.g. with sslmode=require in production.
DATABASE_URL=
# Leave unset in production. The in-memory store is a development aid only.
ALLOW_IN_MEMORY_FALLBACK=false

# --- Demo accounts ---------------------------------------------------------
# Off by default in production. Never enable on an instance holding real data.
DEMO_ACCESS_ENABLED=false

# --- Gnani speech ----------------------------------------------------------
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_API_KEY=
GNANI_TIMEOUT_MS=15000
# Shared daily request budget for the paid speech key (STT + TTS).
GNANI_DAILY_BUDGET=1000

# --- Acoustic analysis service (ai-service/) --------------------------------
# FastAPI service that measures uploaded speech clips. Leave AI_SERVICE_URL
# unset to disable the acoustic path; /api/v1/voice/acoustics then returns
# 503 AI_SERVICE_UNCONFIGURED and the client keeps its browser-side measurements.
# AI_SERVICE_INTERNAL_KEY must equal INTERNAL_API_KEY in ai-service/.env.
AI_SERVICE_URL=
AI_SERVICE_INTERNAL_KEY=

# --- Rate limits -----------------------------------------------------------
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_MS=60000
ARABIC_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=3600000

# --- Transactional email (password reset / signup codes) -------------------
# Create a key at https://resend.com/api-keys. When unset, codes are only
# surfaced outside production as a development fallback.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
EMAIL_FROM="NeuLens <no-reply@your-domain.example>"

# --- Optional integrations -------------------------------------------------
FHIR_BASE_URL=
FHIR_BEARER_TOKEN=
FHIR_IDENTIFIER_SYSTEM=
EVON_INFERENCE_URL=
EVON_API_KEY=
EVON_DATA_PROCESSING_APPROVED=false

# Patient voice copilot & Clinical Decision Support:
# Google Gemini (Google Startup Buildathon Primary Integration):
# Get key at https://aistudio.google.com / Google Cloud Vertex AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Generic OpenAI / Custom endpoint fallback (optional):
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_MODEL=
RIGHTNOW_ARABIC_ENABLED=false
ARABERT_ENABLED=false
ARABERT_MODEL_ID=
